# Copie este arquivo para ".env" (na raiz do projeto) e preencha. O ".env" nunca vai para o Git.

# Servidor SMTP. Exemplo para Gmail: smtp.gmail.com, porta 587 (STARTTLS) ou 465 (SSL).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Conta que envia os alertas. No Gmail, ative a verificação em duas etapas e crie uma
# "senha de app" em https://myaccount.google.com/apppasswords (não use a senha normal da conta).
SMTP_USER=seu.email@gmail.com
SMTP_PASSWORD=senha-de-app-de-16-letras

# Opcional: nome/endereço que aparece como remetente (padrão: SMTP_USER).
ALERTA_REMETENTE=

# Quem recebe os alertas (separe vários por vírgula).
ALERTA_DESTINATARIOS=seu.email@gmail.com
