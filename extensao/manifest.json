{
  "manifest_version": 3,
  "name": "SEARCHING - Coleta assistida",
  "version": "2.0.0",
  "description": "Lê a página do produto que você abre pelo SEARCHING e envia preço e print ao seu servidor SEARCHING (local ou hospedado). Uma página por clique seu.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "opcoes.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "ponte.js"
      ],
      "run_at": "document_start"
    }
  ]
}
